{
  "schemaVersion": 1,
  "name": "Dormammu AI Operations Center",
  "description": "Autonomous multi-stage incident triage and operations center engine: validates inbound payloads, performs parallel AI classification and business impact scoring, enriches with service health, routes across severity tiers, and produces structured operational reports.",
  "samplePayload": {
    "incident_id": "INC-8092",
    "ticketId": "INC-8092",
    "service": "payment-gateway",
    "title": "Payment gateway returning HTTP 504 errors",
    "description": "Multiple users cannot complete checkout.",
    "customer_tier": "enterprise",
    "customerTier": "enterprise",
    "affected_users": 1200,
    "affectedUsers": 1200,
    "error_rate": 0.42,
    "errorRate": 0.42,
    "latency_ms": 3400,
    "failed_transactions": 620,
    "revenue_at_risk": 54800,
    "region": "ap-south-1",
    "recent_deploy": true,
    "logs": [
      "2026-10-26T00:14:12Z [ERROR] HTTP 504 Gateway Timeout upstream provider",
      "2026-10-26T00:14:18Z [WARN] Connection pool exhausted: active=100/100 queue=450",
      "2026-10-26T00:15:02Z [ERROR] Checkout transaction aborted after 30000ms"
    ]
  },
  "nodes": [
    {
      "id": "trig_ops",
      "type": "trigger.manual",
      "version": 1,
      "name": "Inbound Incident Ingestion",
      "position": { "x": 60, "y": 280 },
      "config": {
        "defaultPayload": {
          "incident_id": "INC-8092",
          "ticketId": "INC-8092",
          "service": "payment-gateway",
          "title": "Payment gateway returning HTTP 504 errors",
          "description": "Multiple users cannot complete checkout.",
          "customer_tier": "enterprise",
          "customerTier": "enterprise",
          "affected_users": 1200,
          "affectedUsers": 1200,
          "error_rate": 0.42,
          "errorRate": 0.42,
          "latency_ms": 3400,
          "failed_transactions": 620,
          "revenue_at_risk": 54800,
          "region": "ap-south-1",
          "recent_deploy": true,
          "logs": [
            "2026-10-26T00:14:12Z [ERROR] HTTP 504 Gateway Timeout upstream provider",
            "2026-10-26T00:14:18Z [WARN] Connection pool exhausted: active=100/100 queue=450",
            "2026-10-26T00:15:02Z [ERROR] Checkout transaction aborted after 30000ms"
          ]
        }
      }
    },
    {
      "id": "validate_incident",
      "type": "data.validate",
      "version": 1,
      "name": "Validate Incident Schema",
      "position": { "x": 300, "y": 280 },
      "config": {
        "requiredFields": [
          "incident_id|ticketId",
          "service",
          "error_rate|errorRate",
          "affected_users|affectedUsers"
        ],
        "rules": {
          "error_rate|errorRate": { "type": "number", "min": 0, "max": 1 },
          "affected_users|affectedUsers": { "type": "number", "min": 0 },
          "latency_ms": { "type": "number", "min": 0 }
        }
      }
    },
    {
      "id": "normalize_incident",
      "type": "data.object",
      "version": 1,
      "name": "Normalize Incident",
      "position": { "x": 540, "y": 280 },
      "config": {
        "fields": [
          { "key": "ticketId", "fromInput": true, "inputKey": "ticketId|incident_id" },
          { "key": "title", "fromInput": true },
          { "key": "description", "fromInput": true },
          { "key": "service", "fromInput": true },
          { "key": "customerTier", "fromInput": true, "inputKey": "customerTier|customer_tier" },
          { "key": "affectedUsers", "fromInput": true, "inputKey": "affectedUsers|affected_users" },
          { "key": "errorRate", "fromInput": true, "inputKey": "errorRate|error_rate" },
          { "key": "latencyMs", "fromInput": true, "inputKey": "latencyMs|latency_ms" },
          { "key": "failedTransactions", "fromInput": true, "inputKey": "failedTransactions|failed_transactions" },
          { "key": "revenueAtRisk", "fromInput": true, "inputKey": "revenueAtRisk|revenue_at_risk" },
          { "key": "region", "fromInput": true },
          { "key": "recentDeploy", "fromInput": true, "inputKey": "recentDeploy|recent_deploy" },
          { "key": "logs", "fromInput": true },
          { "key": "source", "fromInput": true }
        ]
      }
    },
    {
      "id": "fetch_service_telemetry",
      "type": "http.request",
      "version": 1,
      "name": "Fetch Service Telemetry",
      "position": { "x": 840, "y": 60 },
      "config": {
        "method": "GET",
        "url": "http://localhost:5001/api/mock/monitoring/services/{{service}}",
        "targetUrl": "http://localhost:5001/api/mock/monitoring/services/{{service}}",
        "allowPrivateNetwork": true,
        "failOnError": true,
        "timeoutMs": 8000
      }
    },
    {
      "id": "ai_classifier",
      "type": "ai.classify",
      "version": 1,
      "name": "AI Incident Classifier",
      "position": { "x": 840, "y": 200 },
      "config": {
        "provider": "groq",
        "model": "openai/gpt-oss-120b",
        "categories": [
          "service_outage",
          "performance_degradation",
          "support_inquiry"
        ],
        "instructions": "Classify critical payment timeouts and gateway failures as service_outage, latency spikes as performance_degradation, and routine inquiries as support_inquiry"
      }
    },
    {
      "id": "get_affected_users",
      "type": "json.get",
      "version": 1,
      "name": "Extract Affected Users",
      "position": { "x": 840, "y": 360 },
      "config": {
        "path": "affected_users|affectedUsers"
      }
    },
    {
      "id": "get_error_rate",
      "type": "json.get",
      "version": 1,
      "name": "Extract Error Rate",
      "position": { "x": 840, "y": 480 },
      "config": {
        "path": "error_rate|errorRate"
      }
    },
    {
      "id": "calc_raw_impact",
      "type": "math.multiply",
      "version": 1,
      "name": "Users * Error Rate",
      "position": { "x": 1080, "y": 420 },
      "config": {}
    },
    {
      "id": "calc_impact_score",
      "type": "math.round",
      "version": 1,
      "name": "Round Impact Score",
      "position": { "x": 1300, "y": 420 },
      "config": {
        "precision": 0,
        "mode": "round"
      }
    },
    {
      "id": "build_impact_summary",
      "type": "data.object",
      "version": 1,
      "name": "Build Impact Summary",
      "position": { "x": 1540, "y": 420 },
      "config": {
        "inheritInput": false,
        "targetKey": "impactedVolume",
        "fields": [
          { "key": "affectedUsers", "fromInput": true, "inputKey": "affectedUsers|affected_users" },
          { "key": "errorRate", "fromInput": true, "inputKey": "errorRate|error_rate" },
          { "key": "revenueAtRisk", "fromInput": true, "inputKey": "revenueAtRisk|revenue_at_risk" },
          { "key": "customerTier", "fromInput": true, "inputKey": "customerTier|customer_tier" }
        ]
      }
    },
    {
      "id": "route_switch",
      "type": "logic.switch",
      "version": 1,
      "name": "Severity Router",
      "position": { "x": 1100, "y": 200 },
      "config": {
        "cases": ["critical", "warning", "normal"]
      }
    },
    {
      "id": "action_critical",
      "type": "text.template",
      "version": 1,
      "name": "Dispatch Critical Escalation",
      "position": { "x": 1400, "y": 100 },
      "config": {
        "template": "🚨 CRITICAL OUTAGE ESCALATION: Incident {{ticketId}} on [{{service}}]. Dispatched emergency DevOps on-call pager. Impacted Volume: High. Immediate rollback and failover initiated."
      }
    },
    {
      "id": "action_warning",
      "type": "text.template",
      "version": 1,
      "name": "Queue Investigation Notice",
      "position": { "x": 1400, "y": 200 },
      "config": {
        "template": "⚠️ WARNING INVESTIGATION: Incident {{ticketId}} on [{{service}}]. Flagged for prompt engineering investigation. Telemetry indicates elevated latency."
      }
    },
    {
      "id": "action_normal",
      "type": "text.template",
      "version": 1,
      "name": "Standard Support Response",
      "position": { "x": 1400, "y": 300 },
      "config": {
        "template": "📋 STANDARD SUPPORT: Incident {{ticketId}} on [{{service}}]. Created standard business-hours response. No pager dispatch required."
      }
    },
    {
      "id": "merge_actions",
      "type": "flow.merge",
      "version": 1,
      "name": "Merge Action Output",
      "position": { "x": 1700, "y": 200 },
      "config": {
        "mode": "first_available"
      }
    },
    {
      "id": "assemble_final_report",
      "type": "data.object",
      "version": 1,
      "name": "Assemble Operations Report",
      "position": { "x": 1960, "y": 260 },
      "config": {
        "inheritInput": false,
        "fields": [
          { "key": "reportId", "fromInput": true, "inputKey": "ticketId|incident_id" },
          { "key": "ticketId", "fromInput": true, "inputKey": "ticketId|incident_id" },
          { "key": "service", "fromInput": true },
          { "key": "customerTier", "fromInput": true, "inputKey": "customerTier|customer_tier" },
          { "key": "incident.ticketId", "fromInput": true, "inputKey": "ticketId|incident_id" },
          { "key": "incident.title", "fromInput": true, "inputKey": "title" },
          { "key": "incident.description", "fromInput": true, "inputKey": "description" },
          { "key": "incident.service", "fromInput": true, "inputKey": "service" },
          { "key": "incident.customerTier", "fromInput": true, "inputKey": "customerTier|customer_tier" },
          { "key": "incident.region", "fromInput": true, "inputKey": "region" }
        ]
      }
    },
    {
      "id": "ops_return",
      "type": "output.return",
      "version": 1,
      "name": "Final Operations Report",
      "position": { "x": 2220, "y": 260 },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "e01",
      "source": "trig_ops",
      "sourcePort": "output",
      "target": "validate_incident",
      "targetPort": "input"
    },
    {
      "id": "e02",
      "source": "validate_incident",
      "sourcePort": "output",
      "target": "normalize_incident",
      "targetPort": "input"
    },
    {
      "id": "e03",
      "source": "normalize_incident",
      "sourcePort": "output",
      "target": "ai_classifier",
      "targetPort": "text"
    },
    {
      "id": "e04",
      "source": "normalize_incident",
      "sourcePort": "output",
      "target": "fetch_service_telemetry",
      "targetPort": "input"
    },
    {
      "id": "e05",
      "source": "normalize_incident",
      "sourcePort": "output",
      "target": "get_affected_users",
      "targetPort": "input"
    },
    {
      "id": "e06",
      "source": "normalize_incident",
      "sourcePort": "output",
      "target": "get_error_rate",
      "targetPort": "input"
    },
    {
      "id": "e07",
      "source": "get_affected_users",
      "sourcePort": "output",
      "target": "calc_raw_impact",
      "targetPort": "a"
    },
    {
      "id": "e08",
      "source": "get_error_rate",
      "sourcePort": "output",
      "target": "calc_raw_impact",
      "targetPort": "b"
    },
    {
      "id": "e09",
      "source": "calc_raw_impact",
      "sourcePort": "output",
      "target": "calc_impact_score",
      "targetPort": "input"
    },
    {
      "id": "e10",
      "source": "normalize_incident",
      "sourcePort": "output",
      "target": "build_impact_summary",
      "targetPort": "input"
    },
    {
      "id": "e11",
      "source": "calc_impact_score",
      "sourcePort": "output",
      "target": "build_impact_summary",
      "targetPort": "value"
    },
    {
      "id": "e12",
      "source": "ai_classifier",
      "sourcePort": "severity",
      "target": "route_switch",
      "targetPort": "value"
    },
    {
      "id": "e13",
      "source": "normalize_incident",
      "sourcePort": "output",
      "target": "route_switch",
      "targetPort": "data"
    },
    {
      "id": "e14",
      "source": "route_switch",
      "sourcePort": "critical",
      "target": "action_critical",
      "targetPort": "input"
    },
    {
      "id": "e15",
      "source": "route_switch",
      "sourcePort": "warning",
      "target": "action_warning",
      "targetPort": "input"
    },
    {
      "id": "e16",
      "source": "route_switch",
      "sourcePort": "normal",
      "target": "action_normal",
      "targetPort": "input"
    },
    {
      "id": "e17",
      "source": "action_critical",
      "sourcePort": "output",
      "target": "merge_actions",
      "targetPort": "input"
    },
    {
      "id": "e18",
      "source": "action_warning",
      "sourcePort": "output",
      "target": "merge_actions",
      "targetPort": "input"
    },
    {
      "id": "e19",
      "source": "action_normal",
      "sourcePort": "output",
      "target": "merge_actions",
      "targetPort": "input"
    },
    {
      "id": "e20",
      "source": "normalize_incident",
      "sourcePort": "output",
      "target": "assemble_final_report",
      "targetPort": "input"
    },
    {
      "id": "e21",
      "source": "fetch_service_telemetry",
      "sourcePort": "body",
      "target": "assemble_final_report",
      "targetPort": "telemetry"
    },
    {
      "id": "e22",
      "source": "build_impact_summary",
      "sourcePort": "output",
      "target": "assemble_final_report",
      "targetPort": "derivedMetrics"
    },
    {
      "id": "e23",
      "source": "ai_classifier",
      "sourcePort": "analysis",
      "target": "assemble_final_report",
      "targetPort": "aiAnalysis"
    },
    {
      "id": "e24",
      "source": "merge_actions",
      "sourcePort": "output",
      "target": "assemble_final_report",
      "targetPort": "actionPlan"
    },
    {
      "id": "e25",
      "source": "assemble_final_report",
      "sourcePort": "output",
      "target": "ops_return",
      "targetPort": "input"
    }
  ]
}
