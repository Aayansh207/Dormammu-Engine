
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  googleId      String?  @unique
  profilePhoto  String?
  role          String   @default("USER")
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  loginHistory       LoginHistory[]
  workflows          Workflow[]
  ownedWorkspaces    Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers   WorkspaceMember[]
  sentInvitations    WorkspaceInvitation[] @relation("SentInvitations")

  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  status    String   // "SUCCESS" | "FAILED"
  method    String   // "CREDENTIALS" | "GOOGLE" | "REFRESH"
  ipAddress String?
  userAgent String?
  device    String?
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_history")
}

model Workflow {
  id          String   @id @default(uuid())
  ownerId     String
  workspaceId String?
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  versions  WorkflowVersion[]

  @@index([ownerId])
  @@index([workspaceId])
  @@map("workflows")
}

model WorkflowVersion {
  id             String   @id @default(uuid())
  workflowId     String
  version        Int
  schemaVersion  String   @default("1.0")
  definitionJson Json
  createdAt      DateTime @default(now())

  workflow Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs     WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowRun {
  id                String    @id @default(uuid())
  workflowId        String?
  workflowVersionId String
  status            String    @default("PENDING") // "PENDING" | "RUNNING" | "SUCCEEDED" | "FAILED" | "CANCELLED"
  triggerType       String    @default("MANUAL")  // "MANUAL" | "WEBHOOK" | "CRON" | "API"
  idempotencyKey    String?
  idempotencyHash   String?
  durationMs        Int?
  input             Json?
  output            Json?
  error             Json?
  report            Json?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  tasks           TaskExecution[]

  @@unique([workflowId, idempotencyKey])
  @@index([workflowId, createdAt])
  @@index([workflowVersionId])
  @@index([status])
  @@map("workflow_runs")
}

model TaskExecution {
  id             String    @id @default(uuid())
  runId          String
  nodeId         String
  nodeType       String
  nodeName       String?
  status         String    @default("PENDING") // "PENDING" | "READY" | "RUNNING" | "SUCCEEDED" | "FAILED" | "BLOCKED" | "SKIPPED" | "CANCELLED"
  attempts       Int       @default(0)
  maxAttempts    Int       @default(1)
  input          Json?
  output         Json?
  error          Json?
  claimedBy      String?
  claimExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  run      WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptsList TaskAttempt[]

  @@unique([runId, nodeId])
  @@index([runId, status])
  @@index([status, claimExpiresAt])
  @@map("task_executions")
}

model TaskAttempt {
  id              String    @id @default(uuid())
  taskExecutionId String
  attemptNumber   Int
  status          String    // "RUNNING" | "SUCCEEDED" | "FAILED"
  error           Json?
  durationMs      Int?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  taskExecution TaskExecution @relation(fields: [taskExecutionId], references: [id], onDelete: Cascade)

  @@unique([taskExecutionId, attemptNumber])
  @@index([taskExecutionId])
  @@map("task_attempts")
}

model OutboxMessage {
  id           String    @id @default(uuid())
  queueName    String
  jobName      String
  payload      Json
  status       String    @default("PENDING") // "PENDING" | "DISPATCHED" | "FAILED"
  retryCount   Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([status, createdAt])
  @@map("outbox_messages")
}


model NodeDefinition {
  id           String   @id @default(uuid())
  type         String
  version      Int      @default(1)
  label        String
  description  String?
  category     String
  inputs       Json
  outputs      Json
  configSchema Json?
  capabilities Json?
  isAvailable  Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([type, version])
  @@index([type])
  @@index([category])
  @@map("node_definitions")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  workflows   Workflow[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        String   @default("VIEWER") // "OWNER" | "EDITOR" | "VIEWER"
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  role        String    @default("EDITOR") // "OWNER" | "EDITOR" | "VIEWER"
  token       String    @unique
  status      String    @default("PENDING") // "PENDING" | "ACCEPTED" | "REJECTED" | "REVOKED"
  invitedById String
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@map("workspace_invitations")
}

