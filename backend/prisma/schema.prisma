
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  googleId      String?  @unique
  profilePhoto  String?
  role          String   @default("USER")
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  loginHistory       LoginHistory[]
  workflows          Workflow[]

  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  status    String   // "SUCCESS" | "FAILED"
  method    String   // "CREDENTIALS" | "GOOGLE" | "REFRESH"
  ipAddress String?
  userAgent String?
  device    String?
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_history")
}

model Workflow {
  id          String   @id @default(uuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions WorkflowVersion[]

  @@index([ownerId])
  @@map("workflows")
}

model WorkflowVersion {
  id             String   @id @default(uuid())
  workflowId     String
  version        Int
  schemaVersion  String   @default("1.0")
  definitionJson Json
  createdAt      DateTime @default(now())

  workflow Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs     WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowRun {
  id                String    @id @default(uuid())
  workflowId        String?
  workflowVersionId String
  status            String    @default("PENDING") // "PENDING" | "RUNNING" | "SUCCEEDED" | "FAILED" | "CANCELLED"
  triggerType       String    @default("MANUAL")  // "MANUAL" | "WEBHOOK" | "CRON" | "API"
  durationMs        Int?
  input             Json?
  output            Json?
  error             Json?
  report            Json?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  taskRuns        TaskRun[]

  @@index([workflowId, createdAt])
  @@index([workflowVersionId])
  @@map("workflow_runs")
}

model TaskRun {
  id            String    @id @default(uuid())
  workflowRunId String
  nodeId        String
  status        String    @default("PENDING") // "PENDING" | "RUNNING" | "SUCCEEDED" | "FAILED" | "SKIPPED"
  attempts      Int       @default(1)
  input         Json?
  output        Json?
  error         Json?
  startedAt     DateTime?
  finishedAt    DateTime?

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([workflowRunId, nodeId])
  @@index([workflowRunId])
  @@map("task_runs")
}

model NodeDefinition {
  id           String   @id @default(uuid())
  type         String
  version      Int      @default(1)
  label        String
  description  String?
  category     String
  inputs       Json
  outputs      Json
  configSchema Json?
  capabilities Json?
  isAvailable  Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([type, version])
  @@index([type])
  @@index([category])
  @@map("node_definitions")
}
